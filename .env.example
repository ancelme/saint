# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ==========================================
# Production Database (MySQL / Relational DB)
# When configured, Node.js connects directly to MySQL.
# If not configured, the app seamlessly defaults to the embedded relational SQL engine.
# ==========================================
DATABASE_HOST=""
DATABASE_USER=""
DATABASE_PASSWORD=""
DATABASE_NAME="st_silas_db"
DATABASE_PORT="3306"

# ==========================================
# Security & JWT Token Authentication
# ==========================================
JWT_SECRET="SET_A_UNIQUE_RANDOM_SECRET_FOR_PRODUCTION"
